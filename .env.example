# =============================================================================
# Atlas — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to version control.
# =============================================================================

# --- Required ---

# PostgreSQL connection string with pgvector extension.
# Examples: postgresql://user:password@localhost:5432/atlas
DATABASE_URL=

# Groq API key for LLM chat generation.
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# Secret key for signing Better Auth session tokens.
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=

# --- Authentication ---

# Base URL of the auth server. Must match the deployed origin.
# Default: http://localhost:8787
BETTER_AUTH_URL=http://localhost:8787

# Allowed CORS origin. Must match the frontend URL.
# Default: http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# --- Embeddings ---

# Embedding provider: "huggingface" (default) or "local"/"local-transformers"
EMBEDDING_PROVIDER=huggingface

# HuggingFace Inference API key.
# Required when EMBEDDING_PROVIDER=huggingface.
# Get one at: https://huggingface.co/settings/tokens
HF_API_KEY=

# --- Local embeddings (EMBEDDING_PROVIDER=local) ---
# Defaults mirror the embedding manifest (server/embeddings/embeddingManifest.js).
# See docs/deployment.md for details.

# ONNX model id on the Hugging Face Hub.
# Default: Xenova/bge-small-en-v1.5 (the documented ONNX export of BAAI/bge-small-en-v1.5).
# Note: BAAI/bge-small-en-v1.5 does not ship ONNX weights, so the Xenova/ conversion is used.
LOCAL_EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# Immutable Hugging Face revision (commit SHA) to pin weights/tokenizer to.
# Default (pinned space): ea104dacec62c0de699686887e3f920caeb4f3e3
EMBEDDING_LOCAL_REVISION=ea104dacec62c0de699686887e3f920caeb4f3e3

# Pooling strategy applied to token embeddings: "mean" (manifest) or "cls" (official BGE). Default: mean
EMBEDDING_LOCAL_POOLING=mean

# Use the 8-bit quantized ONNX weights (~34 MB) instead of fp32 (~133 MB). Default: true
EMBEDDING_LOCAL_QUANTIZED=true

# L2-normalize embeddings before storage (cosine retrieval expects unit vectors). Default: true
EMBEDDING_LOCAL_NORMALIZE=true

# Output embedding dimension; must match chunks.embedding vector(384). Default: 384
EMBEDDING_LOCAL_DIMENSIONS=384

# Allow downloading the model from the Hugging Face Hub on a cache miss.
# Default: true. Set to false to require pre-baked local artifacts (no downloads).
EMBEDDING_LOCAL_ALLOW_REMOTE=true

# Fail fast at startup if the local config disagrees with the embedding manifest. Default: false
EMBEDDING_LOCAL_STRICT=false

# Directory used to cache downloaded model artifacts.
# Default: node_modules/@xenova/transformers/.cache (wiped on reinstall/rebuild).
# Set this to a persistent path so the model is not re-downloaded on every cold start.
EMBEDDING_CACHE_DIR=

# --- LLM Generation ---

# Groq model ID. Default: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# Groq API base URL. Change for proxy or self-hosted endpoints.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# LLM temperature (0-2). Default: 0
GROQ_TEMPERATURE=0

# Maximum tokens per generation. Default: 512
GROQ_MAX_TOKENS=512

# Number of chunks to retrieve for RAG context. Default: 6
GENERATION_TOP_K=6

# Minimum cosine similarity for chunk retrieval. Default: 0.5
GENERATION_SIMILARITY_THRESHOLD=0.5

# Provider name. Only "groq" is implemented.
GENERATION_PROVIDER=groq

# --- OCR ---

# Maximum file size in MB for OCR processing. Default: 15
MAX_OCR_FILE_SIZE_MB=15

# --- Server ---

# HTTP server port. Default: 8787
PORT=8787

# Set to "production" to enable combined request logging and suppress dev debug output.
NODE_ENV=development

# --- Frontend (Vite) ---

# Backend API base URL. In dev with Vite proxy, leave empty.
# In Docker dev: http://localhost:8787
# In production: https://your-api-domain.com
VITE_API_BASE_URL=

# Explicit auth endpoint URL if different from VITE_API_BASE_URL.
VITE_AUTH_URL=

# --- Docker Compose (optional overrides) ---

# PostgreSQL database name. Default: atlas
POSTGRES_DB=atlas

# PostgreSQL user. Default: atlas
POSTGRES_USER=atlas

# PostgreSQL password. Default: atlas
POSTGRES_PASSWORD=atlas

# Docker Compose project name. Default: atlas
COMPOSE_PROJECT_NAME=atlas

# Disable SSL for local PostgreSQL (Docker only). Default: true (SSL enabled)
DATABASE_SSL=false

# PostgreSQL port mapping (Docker dev only). Default: 5432
POSTGRES_PORT=5432

# Frontend port mapping. Default: 80
FRONTEND_PORT=80

# --- pgAdmin (optional, Docker only) ---

# pgAdmin login email. Default: admin@atlas.local
PGADMIN_EMAIL=admin@atlas.local

# pgAdmin login password. Default: admin
PGADMIN_PASSWORD=admin

# pgAdmin port mapping. Default: 5050
PGADMIN_PORT=5050
