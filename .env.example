# =============================================================================
# Atlas — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to version control.
# =============================================================================

# --- Required ---

# PostgreSQL connection string with pgvector extension.
# Examples: postgresql://user:password@localhost:5432/atlas
DATABASE_URL=

# Groq API key for LLM chat generation.
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# Secret key for signing Better Auth session tokens.
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=

# --- Authentication ---

# Base URL of the auth server. Must match the deployed origin.
# Default: http://localhost:8787
BETTER_AUTH_URL=http://localhost:8787

# Allowed CORS origin. Must match the frontend URL.
# Default: http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# --- Embeddings ---

# Embedding provider: "huggingface" (default), "local"/"local-transformers", or "voyage".
# NOTE: hosted and local BGE are different embedding spaces, even though both use
# 384 dimensions. Switching requires the space-provenance migration and re-embed.
# See docs/embedding-migration.md and docs/local-embedding-cutover.md.
EMBEDDING_PROVIDER=huggingface

# HuggingFace Inference API key.
# Required when EMBEDDING_PROVIDER=huggingface.
# Get one at: https://huggingface.co/settings/tokens
HF_API_KEY=

# Legacy `NULL` provenance policy. Default: block.
# `block` refuses to search or count vectors whose embedding space is unknown.
# `include` is a hosted-only compatibility escape hatch for a database whose
# existing hosted vectors have not yet been backfilled with provenance.
# It is rejected for local/Voyage and should be removed after backfill.
# See docs/local-embedding-cutover.md and docs/embedding-migration.md.
EMBEDDING_LEGACY_UNKNOWN_POLICY=block

# --- Voyage embeddings (EMBEDDING_PROVIDER=voyage, opt-in) ---

# Voyage API key. Required when EMBEDDING_PROVIDER=voyage.
# Get one at: https://dashboard.voyageai.com/
VOYAGE_API_KEY=

# Voyage model ID. Default: voyage-4-lite (general-purpose, lowest cost/latency).
# Recommended general-purpose models: voyage-4-lite (cheapest), voyage-4 (balanced),
# voyage-4-large (best quality). Do NOT use domain models (voyage-code-4,
# voyage-law-2, voyage-finance-2) for general Atlas document RAG.
VOYAGE_MODEL=voyage-4-lite

# Voyage API base URL. Default: https://api.voyageai.com/v1
VOYAGE_BASE_URL=https://api.voyageai.com/v1

# Output embedding dimension. Voyage 4-series supports 256/512/1024/2048
# (voyage-4-lite default 1024). Leave blank for the model default.
# NOTE: 384 is NOT supported by any current Voyage model, so this can never match
# the existing chunks.embedding vector(384). A dimension change requires schema
# change + full re-embed. See docs/embedding-migration.md.
VOYAGE_OUTPUT_DIMENSION=

# Voyage input_type override. Leave blank (recommended): the provider sends
# "query" for single query embeddings and "document" for batch document embeddings
# automatically. Set to "query" or "document" only to force one value.
VOYAGE_INPUT_TYPE=

# L2-normalize embeddings before storage. Default: true
VOYAGE_NORMALIZE=true

# --- Voyage backfill dry-run (read-only; scripts/dev/embedding-backfill.mjs) ---

# Disposable LOCAL database the dry-run backfill inspector may read. This tool is
# read-only, never calls a provider, and refuses non-local, staging, or
# production targets. It never falls back to DATABASE_URL; pass --database-url
# instead to avoid setting this variable.
ATLAS_BACKFILL_DATABASE_URL=

# --- Local embeddings (EMBEDDING_PROVIDER=local) ---
# Defaults mirror the embedding manifest (server/embeddings/embeddingManifest.js).
# See docs/deployment.md for details.

# ONNX model id on the Hugging Face Hub.
# Default: Xenova/bge-small-en-v1.5 (the documented ONNX export of BAAI/bge-small-en-v1.5).
# Note: BAAI/bge-small-en-v1.5 does not ship ONNX weights, so the Xenova/ conversion is used.
LOCAL_EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# Immutable Hugging Face revision (commit SHA) to pin weights/tokenizer to.
# Default: the embedding-manifest revision (ea104dac...). Keep it pinned.
EMBEDDING_LOCAL_REVISION=ea104dacec62c0de699686887e3f920caeb4f3e3

# Pooling strategy applied to token embeddings: "mean" (manifest) or "cls" (official BGE). Default: mean
EMBEDDING_LOCAL_POOLING=mean

# Use the 8-bit quantized ONNX weights (~34 MB) instead of fp32 (~133 MB). Default: true
EMBEDDING_LOCAL_QUANTIZED=true

# L2-normalize embeddings before storage (cosine retrieval expects unit vectors). Default: true
EMBEDDING_LOCAL_NORMALIZE=true

# Output embedding dimension; must match chunks.embedding vector(384). Default: 384
EMBEDDING_LOCAL_DIMENSIONS=384

# Allow downloading the model from the Hugging Face Hub on a cache miss.
# Default: false. Set true only for an explicit first-run/dev download.
EMBEDDING_LOCAL_ALLOW_REMOTE=false

# Fail fast on manifest disagreement and verify bundled cache size + SHA-256
# before model initialization. Default: false; production/Docker sets true.
EMBEDDING_LOCAL_STRICT=true

# Optional cache directory. Used only when it already contains the pinned
# manifest artifacts; otherwise the bundled cache below is used automatically.
EMBEDDING_CACHE_DIR=

# Directory containing pre-baked pinned artifacts (Xenova/bge-small-en-v1.5/<revision>/...).
# Default: ./model-cache (created by `npm run build:model`; baked into the Docker image).
# When this directory is complete, no runtime download or cache write occurs.
EMBEDDING_BUNDLED_CACHE_DIR=

# Force the guarded postinstall hook to fetch ./model-cache even when
# EMBEDDING_PROVIDER is not set to local at install time. Default: false
ATLAS_BUNDLE_EMBEDDING_MODEL=false

# --- LLM Generation ---

# Groq model ID. Default: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# Groq API base URL. Change for proxy or self-hosted endpoints.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# LLM temperature (0-2). Default: 0
GROQ_TEMPERATURE=0

# Maximum tokens per generation. Default: 512
GROQ_MAX_TOKENS=512

# Number of chunks to retrieve for RAG context. Default: 6
GENERATION_TOP_K=6

# Minimum cosine similarity for chunk retrieval. Default: 0.5
GENERATION_SIMILARITY_THRESHOLD=0.5

# Provider name. Only "groq" is implemented.
GENERATION_PROVIDER=groq

# --- OCR ---

# Maximum file size in MB for OCR processing. Default: 15
MAX_OCR_FILE_SIZE_MB=15

# --- Server ---

# HTTP server port. Default: 8787
PORT=8787

# Set to "production" to enable combined request logging and suppress dev debug output.
NODE_ENV=development

# --- Frontend (Vite) ---

# Backend API base URL. In dev with Vite proxy, leave empty.
# In Docker dev: http://localhost:8787
# In production: https://your-api-domain.com
VITE_API_BASE_URL=

# Explicit auth endpoint URL if different from VITE_API_BASE_URL.
VITE_AUTH_URL=

# --- Docker Compose (optional overrides) ---

# PostgreSQL database name. Default: atlas
POSTGRES_DB=atlas

# PostgreSQL user. Default: atlas
POSTGRES_USER=atlas

# PostgreSQL password. Default: atlas
POSTGRES_PASSWORD=atlas

# Docker Compose project name. Default: atlas
COMPOSE_PROJECT_NAME=atlas

# Disable SSL for local PostgreSQL (Docker only). Default: true (SSL enabled)
DATABASE_SSL=false

# PostgreSQL port mapping (Docker dev only). Default: 5432
POSTGRES_PORT=5432

# Frontend port mapping. Default: 80
FRONTEND_PORT=80

# --- pgAdmin (optional, Docker only) ---

# pgAdmin login email. Default: admin@atlas.local
PGADMIN_EMAIL=admin@atlas.local

# pgAdmin login password. Default: admin
PGADMIN_PASSWORD=admin

# pgAdmin port mapping. Default: 5050
PGADMIN_PORT=5050
